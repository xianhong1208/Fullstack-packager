# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nuitka_db
DB_USER=postgres
DB_PASSWORD=admin

# Server
HOST=0.0.0.0
PORT=5018
# Enables SQLAlchemy SQL echo. Does NOT enable hot reload.
DEBUG=false
# Application log level (DEBUG/INFO/WARNING/ERROR). Nothing configured the
# root logger before, so info-level messages were silently discarded.
LOG_LEVEL=INFO

# JWT signing key. Leave empty and the service generates one on first start
# and appends it to this file. Treat as a secret — .env must be chmod 600.
JWT_SECRET_KEY=

# Task settings
MAX_LOG_LINES=3000
# How many Nuitka builds may run at once. Nuitka saturates CPU — raising this
# on a shared machine will starve everything else.
MAX_CONCURRENT_BUILDS=3

# === Rate limiting ===
# CSV of reverse-proxy addresses whose X-Forwarded-For header may be believed.
# LEAVE EMPTY unless a proxy actually fronts this service: XFF is client-written,
# so trusting it lets anyone forge a new identity per request and walk through
# the login limiter. Empty = key on the real peer address.
TRUSTED_PROXY_IPS=
# Per-minute, per-IP cap on POST /api/tasks (build submission).
BUILD_SUBMIT_PER_MINUTE=20

# === Git source mode ===
# GITLAB_TOKEN is a SERVER-ONLY secret used by the backend to clone private repos.
# It must NEVER be committed to version control, written to the database, returned
# by any API response, or logged without being masked. If unset, only public repos
# are reachable.
GITLAB_TOKEN=
# Where cloned repositories land. Must be inside an ALLOWED_PATH_PREFIXES entry
# (currently /media/disk0/ or /media/disk1/).
GIT_WORKSPACE_DIR=/media/disk1/Build_workspace
# Optional CSV host allowlist. Empty = any http/https host allowed.
# Example: gitlab.example.com,gitlab.internal
GIT_ALLOWED_HOSTS=
# Max seconds a single clone may take before it is killed.
GIT_CLONE_TIMEOUT=600

# --- Auto venv bootstrap (git mode only) ---
# After clone, the dispatcher runs `uv sync --frozen` (or a requirements.txt
# fallback) in the cloned directory so that nuitka_worker finds a .venv.
# Set to false to skip — you will then have to arrange a .venv yourself.
GIT_AUTO_VENV=true
# Absolute path to the uv binary. Must exist on the server. Typically the
# same uv that start.sh prepends to PATH.
UV_BIN=/home/server3/.local/bin/uv
# PATH used when running the bootstrap subprocess. Must contain UV_BIN's dir.
PRE_BUILD_PATH=/home/server3/.local/bin:/usr/local/bin:/usr/bin:/bin
# Max seconds for the bootstrap step itself.
VENV_BOOTSTRAP_TIMEOUT=900
# uv cache dir used ONLY by bootstrap. Place it on the same filesystem as
# GIT_WORKSPACE_DIR so uv can hardlink from cache instead of copying bytes
# (10x faster and much less disk usage).
BOOTSTRAP_UV_CACHE_DIR=/media/disk1/.uv-cache

# --- Workspace auto-cleanup (git mode only) ---
# Background loop that deletes per-task workspaces under GIT_WORKSPACE_DIR
# based on task status + age. Running/pending tasks are never touched.
WORKSPACE_CLEANUP_ENABLED=true
# Days to keep successful task workspaces. For non-Docker tasks, output
# downloads depend on the workspace existing, so this also limits how long
# output can be downloaded after a successful build.
WORKSPACE_SUCCESS_TTL_DAYS=7
# Days to keep failed/cancelled workspaces (longer for debugging).
WORKSPACE_FAILED_TTL_DAYS=30
# Days to keep orphan workspaces (dirs with no matching task in the DB).
WORKSPACE_ORPHAN_TTL_DAYS=2
# How often the background sweep runs, in hours.
WORKSPACE_CLEANUP_INTERVAL_HOURS=6
# On successful NON-Docker build, shrink workspace to keep only output_dir.
# Preserves the download endpoint while reclaiming ~90% of bytes.
WORKSPACE_SHRINK_ON_SUCCESS=true
# On successful DOCKER build, fully delete the workspace (image tar.gz is
# already in /media/disk1/docker_images so nothing else is needed).
WORKSPACE_DOCKER_DELETE_ON_SUCCESS=true

# --- Docker image exports cleanup ---
# Where exported Docker images (.tar.gz) are written by docker builds.
# Threads used to compress the exported image, when pigz is installed
# (`apt install pigz`). Identical output size at every setting — purely speed.
#
# Sized from this deployment's real artifacts (162 builds, average 2 GB,
# largest 16 GB), not a small sample. A 16 GB export takes 8.4 min with gzip,
# 1.2 min at 8 threads and 28 s at 32, so 8 -> 32 is worth 26-41 s on the big
# builds. Capped rather than "all 128 cores": disk write throughput binds
# around 530 MB/s, and the host runs concurrent Nuitka compiles.
#
# Falls back to gzip automatically if pigz is missing.
DOCKER_EXPORT_COMPRESS_THREADS=32
DOCKER_IMAGES_DIR=/media/disk1/docker_images
# Periodically delete exported images older than the TTL (by file mtime).
# Runs on the same background loop as the workspace sweep.
DOCKER_IMAGES_CLEANUP_ENABLED=true
DOCKER_IMAGES_TTL_DAYS=30

# --- In-memory task retention ---
# Minutes to keep finished (completed/failed/cancelled) tasks in memory
# before eviction. History stays in the DB forever; this only bounds RAM.
FINISHED_TASK_RETENTION_MINUTES=60

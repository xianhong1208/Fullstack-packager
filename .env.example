# =============================================================================
# Build Center — environment configuration
#
# The ONLY required settings are the PostgreSQL connection below. Everything
# else has a sensible default (see app/config.py for the full list, and README
# for the notable ones). Secrets left empty are generated on first start and
# appended here — keep this file chmod 600.
# =============================================================================

# --- Database (optional) ------------------------------------------------------
# Defaults to a local SQLite file (./data/build_center.db) — zero setup. To use
# PostgreSQL, set DATABASE_URL to its DSN and nothing else is needed:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/build_center
# DATABASE_URL=

# --- Server (optional) --------------------------------------------------------
# HOST=0.0.0.0
# PORT=5018
# LOG_LEVEL=INFO

# --- Secrets (auto-generated when empty) --------------------------------------
JWT_SECRET_KEY=
SETTINGS_ENCRYPTION_KEY=

# --- Bootstrap admin ----------------------------------------------------------
# Created on first start when the database has no users, so you can log in right
# away. CHANGE THE PASSWORD after first login. Set BOOTSTRAP_ADMIN_PASSWORD empty
# to disable and use self-registration instead.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=password123

# --- MCP Center single sign-on (optional; off by default) ---------------------
# Enable to add a "Sign in with MCP Center" button. Register Build Center as an
# OAuth client in MCP Center, then fill these in.
# MCP_OAUTH_ENABLED=true
# MCP_CENTER_URL=http://localhost:4568
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=
# MCP_OAUTH_REDIRECT_URI=http://localhost:5018/auth/oauth/mcp/callback

# --- Notable optional settings (defaults shown; uncomment to override) --------
# Git access tokens for private repos are managed in the console UI, not here.
# GITLAB_TOKEN=                       # legacy fallback for GitLab hosts only
# GIT_WORKSPACE_DIR=./data/workspace  # where clones / build workspaces live
# LOCAL_SOURCE_ROOTS=                 # CSV of dirs local-source builds may read (empty = off)
# MAX_CONCURRENT_BUILDS=3             # simultaneous Nuitka builds
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# TRUSTED_PROXY_IPS=                  # proxy IPs whose X-Forwarded-For to trust (empty = safest)

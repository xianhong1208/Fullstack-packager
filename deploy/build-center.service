# Build Center — systemd unit
#
# Why this exists: the service is currently started by hand with `./start.sh`,
# so it's gone after a reboot, and nothing brings it back up after it crashes.
#
# Install:
#   cp deploy/build-center.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now build-center
#   systemctl status build-center
#   journalctl -u build-center -f
#
# Note: before installing, make sure no manually started instance is still
# holding the port (ss -ltnp | grep 5018), or the new one will fail to bind.

# Adjust WorkingDirectory / User / PATH / ExecStart below to match where you
# installed Build Center and where uv lives.

[Unit]
Description=Build Center — Nuitka / frontend / Docker packaging service
Documentation=https://github.com/xianhong1208/Fullstack-packager
After=network-online.target postgresql.service
Wants=network-online.target
# On repeated crashes, don't restart forever and flood the journal; if it fails
# 5 times within 5 minutes, stop and wait for someone to look.
# These two keys belong to [Unit] on systemd >= 230; placing them in [Service]
# gets them silently ignored.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec

# The service runs as root: needed to compile target projects, write to the
# workspace, and call docker. It's also the owner of .venv and .venv-py3XX --
# switching users breaks all of uv's interpreter symlinks, which is exactly why
# the per-version venvs once failed en masse (see scripts/setup_nuitka_venvs.sh).
User=root
Group=root
WorkingDirectory=/opt/build-center

# uv is installed in the user's home directory, which systemd's default PATH
# can't find.
Environment=PATH=/opt/build-center/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1

# Secrets are brought in from here rather than pydantic-settings reading .env
# directly.
# WARNING: once you switch to EnvironmentFile, the secrets appear in the service
# process's environ -- and nuitka_worker's smoke test currently passes the whole
# os.environ to the "executable the user compiled". Before enabling this line,
# change the smoke test to use an allowlist, or you're effectively handing
# JWT_SECRET_KEY / GITLAB_TOKEN to arbitrary code under test.
# EnvironmentFile=/opt/build-center/.env

ExecStart=/usr/local/bin/uv run python main.py

# Builds routinely take tens of minutes; on stop, give a running Nuitka time to
# wrap up instead of an immediate SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=120

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=build-center

# A single process is intentional: TaskManager's task state, the WebSocket
# connection set, and the build semaphore all live in process memory, so a
# second worker wouldn't see the first's tasks.
# Do not add uvicorn --workers here.

[Install]
WantedBy=multi-user.target
